module RegisterFileSim;
  reg [31:0] I;
  reg [3:0] RegSel;
  reg [3:0] ScrSel;
  reg [2:0] FunSel;
  reg [2:0] OutASel;
  reg [2:0] OutBSel;
  reg Clock;
  wire [31:0] OutA;
  wire [31:0] OutB;
 
 RegisterFile RF1(
   .I(I),
   .RegSel(RegSel),
   .ScrSel(ScrSel),
   .FunSel(FunSel),
   .OutASel(OutASel),
   .OutBSel(OutBSel),
   .Clock(Clock),
   .OutA(OutA),
   .OutB(OutB)
 );
 
