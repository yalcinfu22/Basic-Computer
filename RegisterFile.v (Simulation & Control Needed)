module RegisterFile(I, RegSel, ScrSel, FunSel,
                    OutASel, OutBSel, Clock, OutA, OutB);
input wire [31:0] I;
input wire [3:0] RegSel;
input wire [3:0] ScrSel;
input wire [2:0] FunSel;
input wire [2:0] OutASel;
input wire [2:0] OutBSel;
input wire Clock;
output reg [31:0] OutA;
output reg [31:0] OutB;

parameter numR = 4;
wire [31:0] ROut [1:numR];
genvar i;
generate
  for(i = numR; i >= 1; i = i-1)
  begin : R
      Register32bit general(
      .I(I),
      .E(RegSel[numR-i]),
      .FunSel(FunSel),
      .Clock(Clock),
      .Q(ROut[i])
      );
   end
endgenerate

parameter numS = 4;
wire [31:0] SOut [1:numS];
generate
  for(i = numS; i >= 1; i = i-1)
  begin : S
      Register32bit scratch(
      .I(I),
      .E(ScrSel[numS-i]),
      .FunSel(FunSel),
      .Clock(Clock),
      .Q(SOut[i])
      );
   end
endgenerate

always@(*) // Multiplexer: connects only one register's output to OutA at a time based on OutASel
begin
begin
  case (OutASel)
  3'd0 : OutA = ROut[1];
  3'd1 : OutA = ROut[2];
  3'd2 : OutA = ROut[3];
  3'd3 : OutA = ROut[4];
  3'd4 : OutA = SOut[1];
  3'd5 : OutA = SOut[2];
  3'd6 : OutA = SOut[3];
  3'd7 : OutA = SOut[4];
  default: OutA = 32'b0;
  endcase
end

always@(*) // Multiplexer: connects only one register's output to OutB at a time based on OutBSel
begin
  case (OutBSel)
  3'd0 : OutB = ROut[1];
  3'd1 : OutB = ROut[2];
  3'd2 : OutB = ROut[3];
  3'd3 : OutB = ROut[4];
  3'd4 : OutB = SOut[1];
  3'd5 : OutB = SOut[2];
  3'd6 : OutB = SOut[3];
  3'd7 : OutB = SOut[4];
  default: OutB = 32'b0;
  endcase
end
endmodule
